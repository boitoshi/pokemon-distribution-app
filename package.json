{
  "name": "pokemon-distribution-app",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync-data": "node scripts/sync-from-pokemon-data.mjs",
    "dev": "node scripts/sync-from-pokemon-data.mjs && astro dev",
    "prebuild": "node scripts/sync-from-pokemon-data.mjs",
    "build": "node scripts/build-safe.mjs",
    "build:prod": "node scripts/sync-from-pokemon-data.mjs && DEPLOY_TARGET=production node scripts/build-safe.mjs",
    "preview": "astro preview",
    "lint": "node scripts/lint-project.mjs",
    "check": "astro check",
    "smoke": "node scripts/validate-data.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2"
  }
}
