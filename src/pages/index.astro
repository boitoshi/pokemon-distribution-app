  .preview .results-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 19px 0 14px; }
  .preview .results-heading p { font-weight: 700; }
  .preview .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); gap: 16px; }
  .preview .distribution-card { display: flex; gap: 15px; min-width: 0; padding: 18px; background: white; color: var(--pv-ink); border: 1px solid var(--pv-line); border-radius: 10px; text-decoration: none; }
  .preview .distribution-card:hover { border-color: var(--color-primary-dark); box-shadow: 0 3px 12px rgb(48 40 32 / 10%); }
  .preview .card-visual { display: grid; place-items: center; flex: 0 0 80px; width: 80px; height: 80px; background: var(--pv-soft); border-radius: 8px; position: relative; }
  .preview .card-visual img { position: absolute; max-width: 72px; max-height: 72px; object-fit: contain; }
  .preview .image-fallback { color: var(--pv-muted); font-size: .7rem; }
  .preview .card-content { min-width: 0; flex: 1; }
  .preview .card-content .card-title-row { margin: 8px 0 3px; }
  .preview .card-content h3 { margin: 0; font-size: 1.1rem; }
  .preview .event-name { margin-bottom: 12px; color: var(--pv-muted); line-height: 1.45; overflow-wrap: anywhere; }
  .preview .state { display: inline-block; padding: 4px 8px; background: #f2eee8; color: #554d45; border-radius: 4px; font-size: .75rem; font-weight: 800; }
  .preview .state-soon { background: #fff0d4; color: #754500; }
  .preview .state-current { background: #e0f3ec; color: #146447; }
  .preview .state-ended { background: #eef0f2; color: #58616d; }
  .preview .card-content dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 5px 10px; margin: 0; line-height: 1.45; }
  .preview .card-content dt { color: var(--pv-muted); }
  .preview .card-content dd { overflow-wrap: anywhere; }
  .preview .more { display: block; margin: 22px auto 0; padding: 12px 24px; background: var(--color-primary); border: 1px solid var(--color-primary-dark); border-radius: 7px; color: var(--pv-ink); font-weight: 800; cursor: pointer; }
  .preview .more[hidden] { display: none; }
  .preview .empty { grid-column: 1 / -1; padding: 25px; background: white; border: 1px solid var(--pv-line); border-radius: 10px; }
  .preview #results-heading { scroll-margin-top: 12px; }
  .preview :focus-visible { outline: 3px solid #ef9a23; outline-offset: 3px; }
  @media (max-width: 768px) {
    .preview .search-result-shortcut:not([hidden]) { display: inline-flex; align-items: center; min-height: 44px; margin-top: 5px; color: var(--pv-link); font-weight: 800; text-underline-offset: 3px; }
    .preview .filter-toggle { display: block; width: 100%; min-height: 44px; margin-bottom: 12px; padding: 9px 13px; background: white; color: var(--pv-ink); border: 1px solid var(--pv-control-line); border-radius: 7px; font-weight: 800; text-align: left; cursor: pointer; }
    .preview .filter-toggle::after { content: '⌄'; float: right; }
    .preview .filter-toggle[aria-expanded="true"]::after { content: '⌃'; }
    .preview .filter-panel { display: none; }
    .preview .filter-toggle[aria-expanded="true"] + .filter-panel { display: block; }
  }
  @media (max-width: 640px) { .preview .section-heading { display: block; } .preview .section-heading > p { margin-top: 7px; } .preview .featured-list, .preview .card-grid { grid-template-columns: 1fr; } .preview .distribution-card { padding: 14px; } .preview .distribution-card .card-visual { flex-basis: 64px; width: 64px; height: 64px; } .preview .distribution-card .card-visual img { max-width: 58px; max-height: 58px; } }
</style>
